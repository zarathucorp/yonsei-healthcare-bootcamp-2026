## savedata.R
## dataconvert.R 로 변환된 csv → 분석 전용 소형 fst 파일 미리 생성.
## m30/m60 은 수GB 단위라 매번 읽으면 느리니까 HTN 연구에 쓸 코드만 필터해 저장.
##
## 생성 파일 (USE_EXAMPLE=TRUE: exampledata/data/working/, FALSE: data/working/)
##   m3060_studydrug.fst : HTN 항고혈압제 + Dementia 약 (m30 MCARE_DIV_CD + m60 GNL_NM_CD 합친 long form)
##   m30_brainImg.fst    : Brain CT/MRI (stroke 확진 imaging)
##   m30_Revasc.fst      : PCI + CABG 행위코드
##   k30_acu.fst         : 침치료 행위코드 (k30)
library(data.table); library(magrittr); library(fst)
setDTthreads(0)
source("00_codes_lookup.R")
