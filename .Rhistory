## dataconvert.R
## SAS (.sas7bdat) → csv / fst 변환. 본 분석은 csv 파일을 기본으로 사용.
## 공단 분석실에서 read_sas 는 매우 느리므로 미리 한 번만 변환해두고 이후 fread 사용.
##
## USE_EXAMPLE = TRUE  → ./exampledata/data/nsc2_*_1000.sas7bdat → ./exampledata/data/nsc2_*_1000.csv
## USE_EXAMPLE = FALSE → 본 분석실 경로 (예: /userdata22/room273/data_source/) 구조:
##                        data_source/nsc2_<v>.sas7bdat
##                        data_source/1619/nsc2_<v>_1619.sas7bdat
##                        → 두 구간을 rbind 해서 ./data/nsc2_<v>.csv 저장
library(haven); library(data.table); library(magrittr)
setDTthreads(0)   ## 0: All cores
USE_EXAMPLE <- TRUE
OUT_FORMAT  <- "csv"   ## "csv" or "fst" or "both"
## p20/p30 은 본 연구 로직에 불필요 (약물 처방은 m60 의 GNL_NM_CD 사용).
## g1e_0208, g1e_0915 는 컬럼 스키마가 다르므로 각각 개별 파일로 유지 (rbind 금지).
tables <- c("bnc", "bnd", "inst",
"m20", "m30", "m40", "m60",
"k20", "k30", "k40",
"g1e_0208", "g1e_0915")
save_one <- function(d, out_base) {
if (OUT_FORMAT %in% c("csv","both")) fwrite(d, paste0(out_base, ".csv"))
if (OUT_FORMAT %in% c("fst","both")) {
if (!requireNamespace("fst", quietly = TRUE)) {
stop("OUT_FORMAT includes 'fst', but the fst package is not available in this R environment.")
}
fst::write_fst(d, paste0(out_base, ".fst"))
}
}
if (USE_EXAMPLE) {
in_dir  <- "exampledata/data"
out_dir <- "exampledata/data"
suffix  <- "_1000"
for (v in tables) {
fin <- file.path(in_dir, sprintf("nsc2_%s%s.sas7bdat", v, suffix))
if (!file.exists(fin)) { message("skip (missing): ", fin); next }
message(">> ", v)
d <- read_sas(fin) %>% data.table
save_one(d, file.path(out_dir, sprintf("nsc2_%s%s", v, suffix)))
}
} else {
## 본데이터: <v> + _1619 확장 분을 rbind
in_dir   <- "data_source"
in_dir19 <- file.path(in_dir, "1619")
out_dir  <- "data"
if (!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)
for (v in tables) {
fin1 <- file.path(in_dir,   sprintf("nsc2_%s.sas7bdat", v))
fin2 <- file.path(in_dir19, sprintf("nsc2_%s_1619.sas7bdat", v))
parts <- list()
if (file.exists(fin1)) { message(">> ", v, " (base)"); parts <- c(parts, list(read_sas(fin1) %>% data.table)) }
if (file.exists(fin2)) { message(">> ", v, " (1619)"); parts <- c(parts, list(read_sas(fin2) %>% data.table)) }
if (length(parts) == 0) { message("skip (missing): ", v); next }
d <- rbindlist(parts, fill = TRUE)
save_one(d, file.path(out_dir, sprintf("nsc2_%s", v)))
}
}
## ---------- 변환 후 로딩 예시 ----------
## 예시데이터 (csv):
##   inst <- fread("exampledata/data/nsc2_inst_1000.csv")
