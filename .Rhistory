paste0(yr, if (yr == 1L) " year" else " years"),
levels = c("1 year", "2 years", "3 years")
),
LDL = get(ldl_var),
LDL70 = factor(
as.character(get(ldl70_var)),
levels = c("0", "1")
),
LDL55 = factor(
as.character(get(ldl55_var)),
levels = c("0", "1")
)
)]
}))
out.long.label <- jstable::mk.lev(out.long)
long_labels <- c(
ID = "Participant ID",
group = "Treatment group",
timepoint = "Timepoint",
LDL = "LDL-C, mg/dL",
LDL70 = "LDL-C <70 mg/dL",
LDL55 = "LDL-C <55 mg/dL"
)
for (v in names(long_labels)) {
out.long.label[
variable == v,
var_label := unname(long_labels[v])
]
}
for (v in c("LDL70", "LDL55")) {
out.long.label[
variable == v,
val_label := c("No", "Yes")
]
}
group_levels <- levels(out$group)
base_labels <- variable_labels[varlist$Base]
clinical_labels <- variable_labels[varlist$Clinical]
safety_labels <- variable_labels[varlist$Safety]
subgroup_labels <- variable_labels[varlist$Subgroup]
synthetic_note <- "Synthetic example data; not original RACING patient-level data."
safety_population_note <- paste(
"Safety endpoints were summarised among all randomised participants",
"because allocated-treatment receipt and safety population variables",
"were unavailable in the synthetic data."
)
intolerance_note <- paste(
"The intolerance-discontinuation row was derived from",
"intolerance-related safety endpoints in the synthetic data."
)
stopifnot(
nrow(out) == 3780L,
!("ID" %in% names(out)),
nrow(out.long) == 3L * nrow(a),
"ID" %in% names(out.long),
"intolerance_stop_reduce" %in% varlist$Safety
)
## RACING synthetic analysis: analysis.R
## Tables are saved only to Excel. Figures are saved only to PPT.
analysis_file <- tryCatch(normalizePath(sys.frame(1)$ofile, winslash = "/", mustWork = TRUE), error = function(e) NA_character_)
if (is.na(analysis_file)) {
cmd_file <- grep("^--file=", commandArgs(FALSE), value = TRUE)
if (length(cmd_file) > 0) analysis_file <- normalizePath(sub("^--file=", "", cmd_file[1]), winslash = "/", mustWork = TRUE)
}
if (is.na(analysis_file)) analysis_file <- normalizePath("code/RACING/analysis.R", winslash = "/", mustWork = TRUE)
out
## RACING synthetic analysis: analysis.R
## Tables are saved only to Excel. Figures are saved only to PPT.
analysis_file <- tryCatch(normalizePath(sys.frame(1)$ofile, winslash = "/", mustWork = TRUE), error = function(e) NA_character_)
if (is.na(analysis_file)) {
cmd_file <- grep("^--file=", commandArgs(FALSE), value = TRUE)
if (length(cmd_file) > 0) analysis_file <- normalizePath(sub("^--file=", "", cmd_file[1]), winslash = "/", mustWork = TRUE)
}
if (is.na(analysis_file)) analysis_file <- normalizePath("code/RACING/analysis.R", winslash = "/", mustWork = TRUE)
endpoint_list <- list(
"Primary endpoint" = "primary_event",
"Secondary efficacy endpoint" = "secondary_event",
"Individual clinical endpoint" = c(
"cv_death_event",
"allcause_death_event",
"mace_event",
"coronary_revasc_event",
"peripheral_revasc_event",
"cv_hosp_event",
"hf_hosp_event",
"nonfatal_stroke_event",
"ischemic_stroke_event",
"hemorrhagic_stroke_event"
)
)
endpoint_table <- rbindlist(lapply(
names(endpoint_list),
function(section) {
variables <- endpoint_list[[section]]
rows <- rbindlist(lapply(variables, function(v) {
event <- as.integer(as.character(out[[v]]))
result <- data.table(
Section = section,
Endpoint = unname(clinical_labels[v])
)
for (grp in group_levels) {
idx <- out$group == grp
n <- sum(idx & !is.na(event))
events <- sum(idx & event == 1L, na.rm = TRUE)
result[, (grp) := sprintf(
"%d/%d (%.1f%%)",
events,
n,
events / n * 100
)]
}
result
}))
rows[duplicated(Section), Section := ""]
rows
}
))
endpoint_table
source("~/HIRA-KNHIS-code/KNHIS/KMED_ljt_HTN_CCW/03_global.R", echo = TRUE)
## codes_lookup.R
## NSC2 진료행위/상병 코드 모음.
## ICD-10 / COD 패턴은 "^(...|...)" 정규식 (anchor 시작). m20[grepl(pat, SICK_SYM1) | grepl(pat, SICK_SYM2)] 형태로 매칭.
## Methods_HTN-TTE_260408.xlsx (자료2)행위코드, ICD10 시트 근거.
library(data.table); library(magrittr)
## ---------- 침치료 행위코드 (k30$ITEM_CD 매칭) ----------
code.acu <- c(
"40011","40012","40030","40040","40050","40060","40070","40080",
"40092","40100","40110",
paste0("401", 20:29),           ## 40120-40129
paste0("4013", 1:4),             ## 40131-40134
"49010","49011",                 ## 약침술
"80610",
paste0("8063", 1:5)              ## 80631-80635
)
## ---------- Brain CT / MRI (stroke 확진 imaging) ----------
code.brainCT  <- c("HA451","HA441","HA461","HA851","HA471")
code.brainMRI <- c("HE101","HE201","HE301","HE401","HE501",
"HE135","HE136","HE235","HE236","HE535","HE536",
"HF101","HF202")
code.brainImg <- c(code.brainCT, code.brainMRI)
## ---------- PCI ----------
code.PCI <- c(paste0("M655", 1:9), paste0("M656", 1:9), paste0("M657", 1:9))
## ---------- CABG ----------
code.CABG <- c(
paste0("OA63", 1:9),
paste0("OB63", 1:9),
"OA641","OA642","OA647",
paste0("O016", 1:9), paste0("O017", 0:1),
paste0("O164", 1:7)
)
code.Revasc <- c(code.PCI, code.CABG)
## ==============================================================
## ICD-10 / COD prefix 정규식 (m20 SICK_SYM1/2, bnd COD1/COD2)
## ==============================================================
## 사용 예: m20[grepl(icd.HTN, SICK_SYM1) | grepl(icd.HTN, SICK_SYM2)]
## ---------- Diagnoses ----------
icd.HTN        <- "^(I1[01]|I15)"   ## I10.x, I11.x, I15.x (Methods KO docx)
icd.AMI        <- "^I2[12]"
icd.Stroke     <- "^I6[0-4]"
icd.HemStroke  <- "^I6[01]"
icd.IschStroke <- "^I63"
icd.HF         <- "^I50"
icd.CKD        <- "^N1[89]"
icd.Dementia   <- "^(F0[012]|G30|G3100|G3182)"
## Other baseline comorbidities
icd.DL   <- "^E78"
icd.T2DM <- "^E1[1-4]"
icd.AF   <- "^I48"
## ---------- CCI 17 components (Quan 2011, ICD-10) ----------
list.cci <- list(
MI                        = "^(I2[12]|I252)",
CHF                       = "^(I099|I110|I130|I132|I255|I420|I42[5-9]|I43|I50|P290)",
Peripheral_VD             = "^(I70|I71|I731|I738|I739|I771|I790|I792|K551|K558|K559|Z958|Z959)",
Cerebro_VD                = "^(G4[56]|H340|I6[0-9])",
Dementia                  = "^(F0[0-3]|F051|G30|G311)",
Chronic_pulmonary_dz      = "^(I27[89]|J4[0-7]|J6[0-7]|J684|J701|J703)",
Rheumatologic_dz          = "^(M0[56]|M315|M3[2-4]|M351|M353|M360)",
Peptic_ulcer_dz           = "^K2[5-8]",
Mild_liver_dz             = "^(B18|K70[0-39]|K71[3-57]|K7[34]|K76[02-46-9]|Z944)",
DM_no_complication        = "^E1[0-4][01689]",
DM_complication           = "^E1[0-4][2-57]",
Hemi_paraplegia           = "^(G041|G114|G80[12]|G8[12]|G83[0-49])",
Renal_dz                  = "^(I120|I131|N03[2-7]|N05[2-7]|N1[89]|N250|Z49[0-2]|Z940|Z992)",
Malig_with_Leuk_lymphoma  = "^C(0[0-9]|1[0-9]|2[0-6]|3[0-4]|37|38|39|40|41|43|4[5-9]|5[0-8]|6[0-9]|7[0-6]|8[1-5]|88|90|97)",
Moderate_severe_liver_dz  = "^(I85|I859|I864|I982|K704|K711|K72[19]|K76[5-7])",
Metastatic_solid_tumor    = "^C(7[7-9]|80)",
AIDS_HIV                  = "^B(2[0-2]|24)"
)
## Quan 2011 original weights (17-item)
cciscore <- c(MI=1, CHF=1, Peripheral_VD=1, Cerebro_VD=1, Dementia=1,
Chronic_pulmonary_dz=1, Rheumatologic_dz=1, Peptic_ulcer_dz=1,
Mild_liver_dz=1, DM_no_complication=1, DM_complication=2,
Hemi_paraplegia=2, Renal_dz=2, Malig_with_Leuk_lymphoma=2,
Moderate_severe_liver_dz=4, Metastatic_solid_tumor=6, AIDS_HIV=6)
## ---------- Other prevalent Dx (baseline 1-year window) ----------
list.Dx <- list(
Dyslipidemia        = icd.DL,
Type2_diabetes      = icd.T2DM,
Atrial_fibrillation = icd.AF
)
## ==============================================================
## COD (사망원인, bnd COD1/COD2)
## ==============================================================
cod.CV         <- "^I(2[0-5]|6[0-9])"    ## CV death: I20-I25, I60-I69
cod.Cancer     <- "^C"                    ## C00-C99
cod.Stroke     <- "^I6"                   ## I60-I69
cod.HemStroke  <- "^I6[01]"               ## I60-I61
cod.IschStroke <- "^I63"                  ## I63
cod.IHD        <- "^I2[0-5]"              ## I20-I25
cod.CSD        <- "^I"                    ## I00-I99
